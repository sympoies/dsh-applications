{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitHub event trigger envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventDigest",
    "capsuleDigest"
  ],
  "properties": {
    "eventDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "capsuleDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
