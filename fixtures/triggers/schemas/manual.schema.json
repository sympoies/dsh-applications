{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manual trigger envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "inputDigest"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "inputDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
