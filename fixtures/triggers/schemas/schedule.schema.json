{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Schedule trigger envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tickId",
    "scheduledAt",
    "inputDigest"
  ],
  "properties": {
    "tickId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "scheduledAt": {
      "type": "string",
      "format": "date-time"
    },
    "inputDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
