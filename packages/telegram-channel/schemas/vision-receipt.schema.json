{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Governed Telegram vision receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "requestRef", "eventRef", "scope", "modelRouteRef", "status", "results"],
  "properties": {
    "action": { "const": "telegram.vision.inspect" },
    "requestRef": { "$ref": "#/$defs/ref" },
    "eventRef": { "$ref": "#/$defs/ref" },
    "scope": { "$ref": "#/$defs/scope" },
    "modelRouteRef": { "$ref": "#/$defs/ref" },
    "status": { "const": "completed" },
    "results": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["imageRef", "text"],
        "properties": { "imageRef": { "$ref": "#/$defs/ref" }, "text": { "type": "string", "maxLength": 16384 } }
      }
    }
  },
  "$defs": {
    "ref": { "type": "string", "pattern": "^ref:[0-9a-f]{64}$" },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["deploymentRef", "audienceRef", "conversationRef"],
      "properties": {
        "deploymentRef": { "$ref": "#/$defs/ref" }, "audienceRef": { "$ref": "#/$defs/ref" }, "conversationRef": { "$ref": "#/$defs/ref" }
      }
    }
  }
}
