{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Governed Telegram media input receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "requestRef", "eventRef", "scope", "inputDigest", "status", "attachmentRefs"],
  "properties": {
    "action": { "const": "telegram.media.input" },
    "requestRef": { "$ref": "#/$defs/ref" },
    "eventRef": { "$ref": "#/$defs/ref" },
    "scope": { "$ref": "#/$defs/scope" },
    "inputDigest": { "$ref": "#/$defs/digest" },
    "status": { "const": "accepted" },
    "attachmentRefs": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } }
  },
  "$defs": {
    "ref": { "type": "string", "pattern": "^ref:[0-9a-f]{64}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["deploymentRef", "audienceRef", "conversationRef"],
      "properties": {
        "deploymentRef": { "$ref": "#/$defs/ref" }, "audienceRef": { "$ref": "#/$defs/ref" }, "conversationRef": { "$ref": "#/$defs/ref" }
      }
    }
  }
}
