{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sympoies.dev/schemas/dsh/agent-session-request.v1.json",
  "$defs": {
    "ref": { "type": "string", "pattern": "^ref:[0-9a-f]{64}$" },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["deploymentRef", "audienceRef", "conversationRef", "targetRef"],
      "properties": {
        "deploymentRef": { "$ref": "#/$defs/ref" }, "audienceRef": { "$ref": "#/$defs/ref" },
        "conversationRef": { "$ref": "#/$defs/ref" }, "targetRef": { "$ref": "#/$defs/ref" }
      }
    },
    "base": {
      "type": "object",
      "properties": {
        "requestRef": { "$ref": "#/$defs/ref" }, "scope": { "$ref": "#/$defs/scope" },
        "workspaceRef": { "$ref": "#/$defs/ref" }, "sessionRef": { "$ref": "#/$defs/ref" },
        "expectedReceiptRef": { "$ref": "#/$defs/ref" }
      }
    }
  },
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["action", "requestRef", "scope", "workspaceRef", "prompt", "timeoutSeconds"],
      "properties": {
        "action": { "const": "agent-session.create" }, "requestRef": { "$ref": "#/$defs/ref" },
        "scope": { "$ref": "#/$defs/scope" }, "workspaceRef": { "$ref": "#/$defs/ref" },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["action", "requestRef", "scope", "workspaceRef", "sessionRef"],
      "properties": {
        "action": { "const": "agent-session.status" }, "requestRef": { "$ref": "#/$defs/ref" },
        "scope": { "$ref": "#/$defs/scope" }, "workspaceRef": { "$ref": "#/$defs/ref" },
        "sessionRef": { "$ref": "#/$defs/ref" }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["action", "requestRef", "scope", "workspaceRef", "sessionRef", "expectedReceiptRef", "metadata"],
      "properties": {
        "action": { "const": "agent-session.attach-metadata" }, "requestRef": { "$ref": "#/$defs/ref" },
        "scope": { "$ref": "#/$defs/scope" }, "workspaceRef": { "$ref": "#/$defs/ref" },
        "sessionRef": { "$ref": "#/$defs/ref" }, "expectedReceiptRef": { "$ref": "#/$defs/ref" },
        "metadata": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["key", "value"],
            "properties": {
              "key": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
              "value": { "type": "string", "maxLength": 512 }
            }
          }
        }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["action", "requestRef", "scope", "workspaceRef", "sessionRef", "expectedReceiptRef", "instruction", "timeoutSeconds"],
      "properties": {
        "action": { "const": "agent-session.continue" }, "requestRef": { "$ref": "#/$defs/ref" },
        "scope": { "$ref": "#/$defs/scope" }, "workspaceRef": { "$ref": "#/$defs/ref" },
        "sessionRef": { "$ref": "#/$defs/ref" }, "expectedReceiptRef": { "$ref": "#/$defs/ref" },
        "instruction": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["action", "requestRef", "scope", "workspaceRef", "sessionRef", "expectedReceiptRef", "reason"],
      "properties": {
        "action": { "const": "agent-session.cancel" }, "requestRef": { "$ref": "#/$defs/ref" },
        "scope": { "$ref": "#/$defs/scope" }, "workspaceRef": { "$ref": "#/$defs/ref" },
        "sessionRef": { "$ref": "#/$defs/ref" }, "expectedReceiptRef": { "$ref": "#/$defs/ref" },
        "reason": { "enum": ["user-request", "superseded", "policy", "timeout"] }
      }
    }
  ]
}

