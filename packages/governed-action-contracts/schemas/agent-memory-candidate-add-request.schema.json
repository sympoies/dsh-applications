{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sympoies.dev/schemas/dsh/agent-memory-candidate-add-request.v1.json",
  "$defs": {
    "ref": {
      "type": "string",
      "pattern": "^ref:[0-9a-f]{64}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deploymentRef",
        "audienceRef",
        "conversationRef",
        "targetRef"
      ],
      "properties": {
        "deploymentRef": {
          "$ref": "#/$defs/ref"
        },
        "audienceRef": {
          "$ref": "#/$defs/ref"
        },
        "conversationRef": {
          "$ref": "#/$defs/ref"
        },
        "targetRef": {
          "$ref": "#/$defs/ref"
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "requestRef",
    "scope",
    "expectedReceiptRef",
    "candidate"
  ],
  "properties": {
    "action": {
      "const": "agent-memory.candidate-add"
    },
    "requestRef": {
      "$ref": "#/$defs/ref",
      "description": "Caller-minted request-level idempotency key; private adapters forward this value unchanged as MediatedHostActionRequest.idempotencyKey."
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "expectedReceiptRef": {
      "$ref": "#/$defs/ref"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "evidenceRefs"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "evidenceRefs": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/ref"
          }
        }
      }
    }
  }
}
