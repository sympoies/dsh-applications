{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sympoies.dev/schemas/dsh/calendar-write-request.v1.json",
  "$defs": {
    "ref": {
      "type": "string",
      "pattern": "^ref:[0-9a-f]{64}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deploymentRef",
        "audienceRef",
        "conversationRef",
        "targetRef"
      ],
      "properties": {
        "deploymentRef": {
          "$ref": "#/$defs/ref"
        },
        "audienceRef": {
          "$ref": "#/$defs/ref"
        },
        "conversationRef": {
          "$ref": "#/$defs/ref"
        },
        "targetRef": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 35
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "startsAt": {
          "$ref": "#/$defs/timestamp"
        },
        "endsAt": {
          "$ref": "#/$defs/timestamp"
        },
        "description": {
          "type": "string",
          "maxLength": 2048
        },
        "location": {
          "type": "string",
          "maxLength": 512
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "requestRef",
    "scope",
    "mutation"
  ],
  "properties": {
    "action": {
      "const": "organization.calendar.write"
    },
    "requestRef": {
      "$ref": "#/$defs/ref",
      "description": "Caller-minted request-level idempotency key; private adapters forward this value unchanged as MediatedHostActionRequest.idempotencyKey."
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "mutation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "title",
            "startsAt",
            "endsAt"
          ],
          "properties": {
            "kind": {
              "const": "create"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "startsAt": {
              "$ref": "#/$defs/timestamp"
            },
            "endsAt": {
              "$ref": "#/$defs/timestamp"
            },
            "description": {
              "type": "string",
              "maxLength": 2048
            },
            "location": {
              "type": "string",
              "maxLength": 512
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "eventRef",
            "patch"
          ],
          "properties": {
            "kind": {
              "const": "update"
            },
            "eventRef": {
              "$ref": "#/$defs/ref"
            },
            "patch": {
              "$ref": "#/$defs/patch"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "eventRef"
          ],
          "properties": {
            "kind": {
              "const": "delete"
            },
            "eventRef": {
              "$ref": "#/$defs/ref"
            }
          }
        }
      ]
    }
  }
}
