{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sympoies.dev/schemas/dsh/agent-memory-request.v1.json",
  "$defs": {
    "ref": { "type": "string", "pattern": "^ref:[0-9a-f]{64}$" },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["deploymentRef", "audienceRef", "conversationRef", "targetRef"],
      "properties": {
        "deploymentRef": { "$ref": "#/$defs/ref" }, "audienceRef": { "$ref": "#/$defs/ref" },
        "conversationRef": { "$ref": "#/$defs/ref" }, "targetRef": { "$ref": "#/$defs/ref" }
      }
    }
  },
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["action", "requestRef", "scope", "query", "maxItems"],
      "properties": {
        "action": { "const": "agent-memory.recall" }, "requestRef": { "$ref": "#/$defs/ref" },
        "scope": { "$ref": "#/$defs/scope" }, "query": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "maxItems": { "type": "integer", "minimum": 1, "maximum": 8 }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["action", "requestRef", "scope", "expectedReceiptRef", "candidate"],
      "properties": {
        "action": { "const": "agent-memory.candidate-add" }, "requestRef": { "$ref": "#/$defs/ref" },
        "scope": { "$ref": "#/$defs/scope" }, "expectedReceiptRef": { "$ref": "#/$defs/ref" },
        "candidate": {
          "type": "object", "additionalProperties": false, "required": ["summary", "evidenceRefs"],
          "properties": {
            "summary": { "type": "string", "minLength": 1, "maxLength": 2048 },
            "evidenceRefs": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/ref" } }
          }
        }
      }
    }
  ]
}

