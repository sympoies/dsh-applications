{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sympoies.dev/schemas/dsh-assistant-read/weather.input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["location", "units", "days"],
  "properties": {
    "location": { "type": "string", "minLength": 1, "maxLength": 256 },
    "units": { "enum": ["metric", "imperial"] },
    "days": { "type": "integer", "minimum": 1, "maximum": 10 },
    "hourlyHours": { "type": "integer", "minimum": 1, "maximum": 24 }
  }
}
