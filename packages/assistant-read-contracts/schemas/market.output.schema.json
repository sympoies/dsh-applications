{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sympoies.dev/schemas/dsh-assistant-read/market.output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "asOf", "summary", "sources", "data"],
  "properties": {
    "status": { "enum": ["completed", "cancelled", "timed-out"] },
    "asOf": { "type": ["string", "null"], "format": "date-time", "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?Z$" },
    "summary": { "type": "string", "maxLength": 8192 },
    "sources": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/source" } },
    "data": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["quotes", "exchangeRates"],
          "properties": {
            "quotes": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/quote" } },
            "exchangeRates": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/rate" } }
          }
        }
      ]
    }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "completed" } } }, "then": { "properties": { "asOf": { "type": "string" }, "sources": { "type": "array", "minItems": 1 }, "data": { "not": { "type": "null" } } } } },
    { "if": { "properties": { "status": { "enum": ["cancelled", "timed-out"] } } }, "then": { "properties": { "asOf": { "type": "null" }, "sources": { "type": "array", "maxItems": 0 }, "data": { "type": "null" } } } }
  ],
  "$defs": {
    "source": { "type": "object", "additionalProperties": false, "required": ["url", "title", "retrievedAt", "contentDigest"], "properties": { "url": { "type": "string", "format": "uri", "maxLength": 2048, "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://(?![^/?#]*@)" }, "title": { "type": "string", "maxLength": 1024 }, "retrievedAt": { "type": "string", "format": "date-time", "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?Z$" }, "publishedAt": { "type": "string", "format": "date-time", "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?Z$" }, "contentDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } } },
    "quote": { "type": "object", "additionalProperties": false, "required": ["symbol", "currency", "price", "observedAt"], "properties": { "symbol": { "type": "string", "minLength": 1, "maxLength": 64 }, "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }, "price": { "type": "number", "minimum": 0 }, "observedAt": { "type": "string", "format": "date-time", "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?Z$" } } },
    "rate": { "type": "object", "additionalProperties": false, "required": ["base", "quote", "rate", "observedAt"], "properties": { "base": { "type": "string", "pattern": "^[A-Z]{3}$" }, "quote": { "type": "string", "pattern": "^[A-Z]{3}$" }, "rate": { "type": "number", "exclusiveMinimum": 0 }, "observedAt": { "type": "string", "format": "date-time", "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?Z$" } } }
  }
}
