{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sympoies.dev/schemas/dsh-assistant-read/taiwan-public-discussion.output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "asOf", "summary", "sources", "data"],
  "properties": {
    "status": { "enum": ["completed", "cancelled", "timed-out"] },
    "asOf": { "type": ["string", "null"], "format": "date-time", "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?Z$" },
    "summary": { "type": "string", "maxLength": 8192 },
    "sources": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/source" } },
    "data": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["locale", "window", "findings", "trends"], "properties": { "locale": { "const": "zh-TW" }, "window": { "$ref": "#/$defs/window" }, "findings": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/finding" } }, "trends": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/trend" } } } }] }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "completed" } } }, "then": { "properties": { "asOf": { "type": "string" }, "sources": { "type": "array", "minItems": 1 }, "data": { "not": { "type": "null" } } } } },
    { "if": { "properties": { "status": { "enum": ["cancelled", "timed-out"] } } }, "then": { "properties": { "asOf": { "type": "null" }, "sources": { "type": "array", "maxItems": 0 }, "data": { "type": "null" } } } }
  ],
  "$defs": {
    "source": { "type": "object", "additionalProperties": false, "required": ["url", "title", "retrievedAt", "contentDigest"], "properties": { "url": { "type": "string", "format": "uri", "maxLength": 2048, "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://(?![^/?#]*@)" }, "title": { "type": "string", "maxLength": 1024 }, "retrievedAt": { "type": "string", "format": "date-time", "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?Z$" }, "publishedAt": { "type": "string", "format": "date-time", "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?Z$" }, "contentDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } } },
    "window": { "type": "object", "additionalProperties": false, "required": ["since", "until"], "properties": { "since": { "type": "string", "format": "date-time", "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?Z$" }, "until": { "type": "string", "format": "date-time", "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?Z$" } } },
    "finding": { "type": "object", "additionalProperties": false, "required": ["claim", "sourceIndexes", "confidence"], "properties": { "claim": { "type": "string", "minLength": 1, "maxLength": 8192 }, "sourceIndexes": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } }, "confidence": { "enum": ["low", "medium", "high"] } } },
    "trend": { "type": "object", "additionalProperties": false, "required": ["label", "direction", "sourceIndexes"], "properties": { "label": { "type": "string", "minLength": 1, "maxLength": 256 }, "direction": { "enum": ["rising", "falling", "stable", "mixed"] }, "sourceIndexes": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } } } }
  }
}
