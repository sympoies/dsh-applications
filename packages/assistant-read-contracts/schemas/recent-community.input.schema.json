{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sympoies.dev/schemas/dsh-assistant-read/recent-community.input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["topic", "since", "until", "sourceClasses", "maxFindings"],
  "properties": {
    "topic": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "since": { "type": "string", "format": "date-time", "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?Z$" },
    "until": { "type": "string", "format": "date-time", "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?Z$" },
    "sourceClasses": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["community", "news", "social"] } },
    "maxFindings": { "type": "integer", "minimum": 1, "maximum": 32 }
  }
}
