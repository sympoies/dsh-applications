{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sympoies.dev/schemas/dsh-assistant-read/web.input.schema.json",
  "oneOf": [
    { "type": "object", "additionalProperties": false, "required": ["operation", "query", "limit"], "properties": { "operation": { "const": "search" }, "query": { "type": "string", "minLength": 1, "maxLength": 2048 }, "limit": { "type": "integer", "minimum": 1, "maximum": 20 } } },
    { "type": "object", "additionalProperties": false, "required": ["operation", "url", "maxChars"], "properties": { "operation": { "const": "extract" }, "url": { "type": "string", "format": "uri", "maxLength": 2048, "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://(?![^/?#]*@)(?![^/?#]*%)(?!\\[)(?!(?:0[xX][0-9A-Fa-f]+|[0-9]+)(?:\\.(?:0[xX][0-9A-Fa-f]+|[0-9]+)){0,3}(?::[0-9]{1,5})?(?:[/?#]|$))(?![Ll][Oo][Cc][Aa][Ll][Hh][Oo][Ss][Tt]\\.?(?::[0-9]{1,5})?(?:[/?#]|$))(?![^/?#]*\\.[Ll][Oo][Cc][Aa][Ll][Hh][Oo][Ss][Tt]\\.?(?::[0-9]{1,5})?(?:[/?#]|$))" }, "maxChars": { "type": "integer", "minimum": 1, "maximum": 65536 } } }
  ]
}
