{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sympoies.dev/schemas/dsh-assistant-read/steam.output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "asOf", "summary", "sources", "data"],
  "properties": {
    "status": { "enum": ["completed", "cancelled", "timed-out"] },
    "asOf": { "type": ["string", "null"], "format": "date-time" },
    "summary": { "type": "string", "maxLength": 8192 },
    "sources": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/source" } },
    "data": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["games"], "properties": { "games": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/game" } } } }] }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "completed" } } }, "then": { "properties": { "asOf": { "type": "string" }, "sources": { "type": "array", "minItems": 1 }, "data": { "not": { "type": "null" } } } } },
    { "if": { "properties": { "status": { "enum": ["cancelled", "timed-out"] } } }, "then": { "properties": { "asOf": { "type": "null" }, "sources": { "type": "array", "maxItems": 0 }, "data": { "type": "null" } } } }
  ],
  "$defs": {
    "source": { "type": "object", "additionalProperties": false, "required": ["url", "title", "retrievedAt", "contentDigest"], "properties": { "url": { "type": "string", "format": "uri", "maxLength": 2048, "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://(?![^/?#]*@)" }, "title": { "type": "string", "maxLength": 1024 }, "retrievedAt": { "type": "string", "format": "date-time" }, "publishedAt": { "type": "string", "format": "date-time" }, "contentDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } } },
    "game": { "type": "object", "additionalProperties": false, "required": ["appId", "name", "currency", "finalPrice", "originalPrice", "discountPercent", "observedAt", "storeUrl"], "properties": { "appId": { "type": "integer", "minimum": 1, "maximum": 2147483647 }, "name": { "type": "string", "minLength": 1, "maxLength": 512 }, "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }, "finalPrice": { "type": "integer", "minimum": 0, "maximum": 2147483647 }, "originalPrice": { "type": "integer", "minimum": 0, "maximum": 2147483647 }, "discountPercent": { "type": "integer", "minimum": 0, "maximum": 100 }, "observedAt": { "type": "string", "format": "date-time" }, "storeUrl": { "type": "string", "format": "uri", "maxLength": 2048, "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://(?![^/?#]*@)" } } }
  }
}
