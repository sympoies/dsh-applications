{
  "name": "@sympoies/dsh-applications-workspace",
  "version": "0.2.1",
  "description": "Governed public applications and plugins for DeepSeek Harness",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "AGENTS.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "compatibility",
    "docs",
    "fixtures",
    "profiles",
    "packages"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:repository-contract": "node --test test/repository-contract.test.mjs",
    "test:manager-contract": "node --test test/manager-contract.test.mjs",
    "test:manager-faults": "node --test test/manager-faults.test.mjs",
    "test:plugin-sandbox": "node --test test/plugin-sandbox.test.mjs",
    "test:profiles": "node --test test/profiles.test.mjs",
    "test:profile-compatibility": "node scripts/check-profile-compatibility.mjs",
    "test:integration": "node --test test/integration.test.mjs",
    "test:exact-dsh": "node scripts/check-exact-dsh-consumer.mjs && node --test test/exact-dsh-consumer.test.mjs",
    "test:github-contracts": "node --test test/github-contracts.test.mjs",
    "check:compatibility": "node scripts/check-compatibility.mjs",
    "verify:package-reproducibility": "node scripts/check-package-reproducibility.mjs",
    "test:package": "npm run check:compatibility -- --manifest-only && npm run verify:package-reproducibility && npm pack --dry-run --ignore-scripts",
    "test:conversation": "node --test test/conversation.test.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.6.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sympoies/dsh-applications.git"
  }
}
