{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Telegram assistant message",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "message"
  ],
  "properties": {
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chatRef",
        "senderRef",
        "isGroup"
      ],
      "properties": {
        "chatRef": {
          "type": "string",
          "pattern": "^ref:[0-9a-f]{64}$",
          "description": "Opaque deployment-scoped keyed reference to one admitted chat."
        },
        "senderRef": {
          "type": "string",
          "pattern": "^ref:[0-9a-f]{64}$",
          "description": "Opaque deployment-scoped keyed reference to one admitted participant."
        },
        "isGroup": {
          "type": "boolean"
        }
      }
    }
  }
}
