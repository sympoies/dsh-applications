{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coding result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "resultDigest"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "maxLength": 16384
    },
    "resultDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
