{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitHub pull-request review output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "findings"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "maxLength": 8192
    },
    "findings": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "message"
        ],
        "properties": {
          "severity": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 4096
          }
        }
      }
    }
  }
}
